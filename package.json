{
  "name": "bountyscout",
  "version": "1.0.0",
  "description": "A tool for tracking and notifying about new bug bounty opportunities",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "bounty",
    "bug-bounty",
    "security",
    "notifications"
  ],
  "author": "dev-kp-eloper",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
